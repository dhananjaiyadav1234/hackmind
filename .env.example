# ── HACKMIND configuration ─────────────────────────────────────────────
# Everything is optional. With no keys the app runs in DEMO / heuristic mode
# (deterministic engine, free research sources only). See README.md.

PORT=8787
HACKMIND_DATA_DIR=./data

# LLM agents (strongly recommended for real use)
ANTHROPIC_API_KEY=
HACKMIND_MODEL=claude-sonnet-5-5

# Web research providers (any one improves search; free sources
# arXiv + GitHub + direct page fetch are always used when network is available)
TAVILY_API_KEY=
BRAVE_API_KEY=
# Optional: raises GitHub search rate limit (read-only public repo access is enough)
GITHUB_TOKEN=

# Set to 1 to force the offline demo engine even if keys are present
HACKMIND_FORCE_DEMO=0
# Set to 1 only for local testing against private hosts (disables SSRF guard)
HACKMIND_ALLOW_PRIVATE_FETCH=0
